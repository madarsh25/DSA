class Solution {
    public int scoreOfParentheses(String s) {
        Stack<Integer> open = new Stack<>();
        open.push(0);

        for (char ch: s.toCharArray()){
            if (ch == '('){
                open.push(0);
            }else{
                int val = open.pop();
                int score = Math.max(2*val, 1);

                int prev = open.pop();
                open.push(prev + score);
            }
        }

        return open.pop();
    }
}
